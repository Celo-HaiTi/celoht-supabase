# Copy to .env and fill in from your Supabase project settings.
# Never commit the real .env file.

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side worker/API configuration. Keep private values out of frontend builds.
CELO_RPC_URL=
CELO_CONFIRMATION_DEPTH=
WORKER_IDENTITY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Network this Supabase project is currently wired for (informational).
# CeloHT is on Celo Sepolia (chainId 11142220) until official Mainnet
# deployment metadata exists in Celo-HaiTi/celoht-smart-contracts.
CELO_CHAIN_ID=11142220
